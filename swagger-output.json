          "default": {
            "description": ""
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUsuario"
              }
            }
          }
        }
      }
    },
    "/api/cuentas/registrar": {
      "post": {
