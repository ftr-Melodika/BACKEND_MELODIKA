          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/api/perfiles/": {
      "get": {
        "tags": [
          "Perfiles"
        ],
        "summary": "Obtener perfiles de la cuenta",
        "description": "",
