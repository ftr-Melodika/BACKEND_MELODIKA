          "default": {
            "description": ""
          }
        }
      },
      "post": {
        "tags": [
          "Perfiles"
        ],
        "summary": "Crear nuevo perfil",
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearPerfil"
              }
            }
          }
        }
      }
    },
    "/api/perfiles/{id}": {
      "delete": {
        "tags": [
          "Perfiles"
        ],
        "summary": "Eliminar perfil (Lógico)",
        "description": "",
