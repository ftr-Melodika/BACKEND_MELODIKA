          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Ingresá el token que te devuelve el login (sin la palabra Bearer)."
      }
    },
    "schemas": {
      "LoginUsuario": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "usuario@ejemplo.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegistroUsuario": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "usuario@ejemplo.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!"
          },
          "nombre": {
            "type": "string",
            "example": "Juan"
          },
          "apellido": {
            "type": "string",
            "example": "Perez"
          },
          "telefono": {
            "type": "string",
            "example": "1123456789"
          }
        },
        "required": [
          "email",
          "password",
          "nombre",
          "apellido",
          "telefono"
        ]
      },
      "CrearPerfil": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Facundo"
          },
          "username": {
            "type": "string",
            "example": "facu_pro"
          },
          "fecha_nacimiento": {
            "type": "string",
            "example": "2005-11-18"
          },
          "genero": {
            "type": "string",
            "example": "Masculino"
          },
          "pais": {
            "type": "string",
            "example": "Argentina"
          },
          "avatarUrl": {
            "type": "string",
            "example": "https://ejemplo.com/avatar.jpg"
          }
        },
        "required": [
          "nombre",
          "username"
        ]
      },
      "ActualizarPerfil": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Facundo Editado"
          },
          "fecha_nacimiento": {
            "type": "string",
            "example": "2005-11-18"
          },
          "genero": {
            "type": "string",
            "example": "Masculino"
          },
          "pais": {
            "type": "string",
            "example": "Uruguay"
          },
          "avatarUrl": {
            "type": "string",
            "example": "https://ejemplo.com/avatar2.jpg"
          }
        }
      },
      "AccionCurso": {
        "type": "object",
        "properties": {
          "perfilId": {
            "type": "string",
            "example": "uuid-del-perfil"
          }
        },
        "required": [
          "perfilId"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}