          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "perfilId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/api/cursos/{cursoId}/lecciones/{leccionId}/completar": {
      "post": {
        "tags": [
          "Cursos"
        ],
        "summary": "Completar lección / ejercicio",
